{
  "realm": "cdd",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,

  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,

  "passwordPolicy": "length(10) and digits(1) and notEmail and notUsername and lowerCase(1)",

  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,

  "internationalizationEnabled": true,
  "supportedLocales": ["pt-BR"],
  "defaultLocale": "pt-BR",

  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@cdd.local",
    "fromDisplayName": "CDD",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },

  "clients": [
    {
      "clientId": "cdd-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "audiencia-cdd-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cdd-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "cdd-api-admin",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CDD_KC_ADMIN_SEGREDO}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "description": "Confidencial, só conta de serviço; usado pela API para gerenciar usuários do Keycloak (papel manage-users)."
    },
    {
      "clientId": "cdd-teste",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "description": "Somente ambiente local/CI de desenvolvimento — obtém token sem navegador para o e2e. Não usar fora de desenvolvimento.",
      "protocolMappers": [
        {
          "name": "audiencia-cdd-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "cdd-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],

  "users": [
    {
      "username": "dev@cdd.local",
      "email": "dev@cdd.local",
      "firstName": "Dev",
      "lastName": "CDD",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${CDD_KC_DEV_SENHA}", "temporary": false }
      ]
    },
    {
      "username": "service-account-cdd-api-admin",
      "enabled": true,
      "serviceAccountClientId": "cdd-api-admin",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
