[Unit]
Description=API do Ceu do Despertar
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cdd-api
Group=cdd-api
WorkingDirectory=/opt/cdd/api/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/cdd/api.env
ExecStart=/opt/cdd/node/current/bin/node --max-old-space-size=256 --enable-source-maps dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=384M
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
