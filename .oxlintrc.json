{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "rules": {
    "unicorn/no-array-sort": "error"
  },
  "overrides": [
    {
      "files": [
        "apps/web/src/**/*.test.ts",
        "apps/web/src/**/*.test.tsx",
        "apps/web/src/testes/**",
        "apps/web/captura/**"
      ],
      "rules": {
        "no-await-in-loop": "off"
      }
    }
  ],
  "ignorePatterns": [
    "apps/api/test/estrutural/fixtures/**",
    "apps/web/test/estrutural/fixtures/**",
    "apps/web/test/estrutural/fixtures-negativas/**",
    "apps/api/src/shared/infrastructure/banco/banco-cdd.gerado.ts"
  ],
  "env": {
    "builtin": true
  }
}
