{
  "name": "@cdd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "pnpm build && concurrently -k -n tsc,node \"tsc -b tsconfig.build.json -w --preserveWatchOutput\" \"node --enable-source-maps --env-file-if-exists=../../.env --watch-path=dist --watch-path=../../packages/contracts/dist dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage"
  },
  "dependencies": {
    "@cdd/contracts": "workspace:*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
