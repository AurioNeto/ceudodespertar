{
  "name": "@cdd/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node scripts/copiar-sql.mjs",
    "dev": "pnpm build && concurrently -k -n tsc,node \"tsc -b tsconfig.build.json -w --preserveWatchOutput\" \"node --enable-source-maps --env-file-if-exists=../../.env --watch-path=dist --watch-path=../../packages/contracts/dist dist/main.js\"",
    "start": "node --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:cobertura": "vitest run --coverage",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "db:migrar": "pnpm build && node --enable-source-maps --env-file-if-exists=../../.env dist/banco/cli.js migrar",
    "db:situacao": "pnpm build && node --enable-source-maps --env-file-if-exists=../../.env dist/banco/cli.js situacao"
  },
  "dependencies": {
    "@cdd/contracts": "workspace:*",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/migrations": "^7.2.1",
    "@mikro-orm/postgresql": "^7.2.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres-array": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "dependency-cruiser": "^18.4.0",
    "pg": "^8.23.0",
    "typescript": "^5.7.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
