TZ=UTC
PORTA=3000
ORIGENS_CORS=http://localhost:5173
LOG_NIVEL=info

POSTGRES_PORTA=5432
POSTGRES_SENHA_SUPERUSUARIO=postgres-dev-local
CDD_OWNER_SENHA=cdd-owner-dev-local
CDD_APP_SENHA=cdd-app-dev-local
BANCO_URL=postgres://cdd_app:cdd-app-dev-local@localhost:5432/cdd
BANCO_URL_MIGRACAO=postgres://cdd_owner:cdd-owner-dev-local@localhost:5432/cdd
BANCO_POOL_MAXIMO=10

KEYCLOAK_ADMIN_SENHA=keycloak-admin-dev-local
CDD_KC_ADMIN_SEGREDO=cdd-kc-admin-segredo-dev-local
CDD_KC_DEV_SENHA=Cdd-Dev-Local-1
OIDC_EMISSOR=http://localhost:8080/realms/cdd
OIDC_AUDIENCIA=cdd-api
KEYCLOAK_URL_BASE=http://localhost:8080
KEYCLOAK_REALM=cdd
KEYCLOAK_ADMIN_CLIENT_ID=cdd-api-admin
# Em deploy, o client cdd-web do realm precisa de <APP_URL_BASE>/* em redirectUris; sem isso o Keycloak recusa todo convite com 400.
APP_URL_BASE=http://localhost:5173
KEYCLOAK_CLIENT_ID_DO_CONVITE=cdd-web

S3_ENDPOINT=http://localhost:9000
S3_REGIAO=us-east-1
S3_BUCKET=cdd-anexos
S3_CHAVE_DE_ACESSO=cdd-dev-chave
S3_SEGREDO=cdd-dev-segredo-local
S3_ESTILO_DE_CAMINHO=true

SMTP_HOST=localhost
SMTP_PORTA=1025
DESPACHANTE_ATIVO=true
DESPACHANTE_INTERVALO_MS=1000

VITE_OIDC_EMISSOR=http://localhost:8080/realms/cdd
VITE_OIDC_CLIENTE=cdd-web
VITE_API_URL=http://localhost:3000

# Só desenvolvimento: sem o /eu na API, liga uma sessão de demonstração no front.
# Só vale com o servidor de desenvolvimento; o build de produção a descarta.
# VITE_SESSAO_DE_DEMONSTRACAO=1
