{
  "name": "cdd-sistema-gestao",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "pnpm --filter @cdd/web dev",
    "build": "pnpm --filter @cdd/web build",
    "preview": "pnpm --filter @cdd/web preview",
    "typecheck": "pnpm -r typecheck",
    "infra:subir": "node infra/keycloak/verificar-realm.mjs && (docker compose up -d; infra/verificar-subida.sh) && node infra/keycloak/verificar-realm-importado.mjs && bash infra/keycloak/fumaca.sh",
    "infra:descer": "docker compose down",
    "infra:zerar": "docker compose down -v",
    "db:verificar": "pnpm --filter @cdd/api test:integracao",
    "lint": "oxlint -c .oxlintrc.json apps/api/src apps/api/test apps/api/scripts apps/api/vitest.config.ts apps/api/vitest.integracao.config.ts packages/contracts/src packages/contracts/test .dependency-cruiser.mjs .dependency-cruiser.web.mjs .dependency-cruiser.web.catraca.mjs apps/web/test",
    "fronteiras": "depcruise --config .dependency-cruiser.mjs apps/api/src packages/contracts/src",
    "fronteiras:web": "depcruise --config .dependency-cruiser.web.mjs apps/web/src",
    "fronteiras:web:catraca": "depcruise --config .dependency-cruiser.web.catraca.mjs --ignore-known .dependency-cruiser-known-violations.web.json apps/web/src",
    "fronteiras:web:linha-de-base": "depcruise --config .dependency-cruiser.web.catraca.mjs --baseline .dependency-cruiser-known-violations.web.json --baseline-mode shrink-only apps/web/src",
    "fronteiras:web:linha-de-base:regenerar": "depcruise --config .dependency-cruiser.web.catraca.mjs --baseline .dependency-cruiser-known-violations.web.json --baseline-mode full apps/web/src",
    "db:migrar": "pnpm --filter @cdd/api db:migrar",
    "db:situacao": "pnpm --filter @cdd/api db:situacao",
    "db:referencia": "infra/postgres/verificar-referencia.sh"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "oxlint": "^1.85.0"
  }
}
